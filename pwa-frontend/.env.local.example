# Frontend API endpoint
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# GitHub links used in the Star/Contribute CTA
# Set this to your public repo after publishing
NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/<repo>

# Creator profile link shown in CTA
NEXT_PUBLIC_CREATOR_URL=https://github.com/<owner>
